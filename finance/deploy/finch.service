[Unit]
Description=Finch personal finance dashboard
After=network.target

[Service]
Type=simple
User=finch
Group=finch
WorkingDirectory=/opt/finch
ExecStart=/usr/bin/node /opt/finch/server.js
Environment=PORT=8484
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/opt/finch/data
Restart=always
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/finch/data

[Install]
WantedBy=multi-user.target
